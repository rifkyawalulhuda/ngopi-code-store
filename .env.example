# =============================================================================
# NgopiCode Digital Store - Environment Variables
# Copy this file to .env and fill in the values before deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Vendure Backend
# -----------------------------------------------------------------------------
VENDURE_PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# PostgreSQL Database
# Requirements: 12.2, 12.4 (pool size 10, configured in vendure-config.ts)
# -----------------------------------------------------------------------------
DB_NAME=ngopicode
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=your-secure-database-password
DB_LOGGING=false
POSTGRES_EXTERNAL_PORT=5432

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=your-secure-admin-password
COOKIE_SECRET=your-random-cookie-secret-min-32-chars

# -----------------------------------------------------------------------------
# MinIO Object Storage
# Requirements: 12.3 (private bucket for digital products)
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key-min-8-chars
MINIO_BUCKET_NAME=products
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host used to SIGN download URLs. Must be reachable by the customer's browser
# AND be the same MinIO the backend uploads to, otherwise every download
# returns 404 NoSuchKey. Local dev: http://localhost:9000
MINIO_PUBLIC_URL=https://storage.ngopicode.com

# -----------------------------------------------------------------------------
# Tripay Payment Gateway
# Requirements: 1.1 - 1.7 (Indonesian payment methods)
# -----------------------------------------------------------------------------
TRIPAY_API_KEY=your-tripay-api-key
TRIPAY_PRIVATE_KEY=your-tripay-private-key
TRIPAY_MERCHANT_CODE=your-tripay-merchant-code
TRIPAY_SANDBOX=false
TRIPAY_CALLBACK_URL=https://your-domain.com/payments/tripay/webhook
TRIPAY_RETURN_URL=https://your-storefront.com/order/confirmation

# -----------------------------------------------------------------------------
# Email (Resend)
# Requirements: 6.1 - 6.4 (order confirmation emails)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=NgopiCode Store

# -----------------------------------------------------------------------------
# Frontend / Storefront
# -----------------------------------------------------------------------------
STOREFRONT_URL=https://your-storefront.vercel.app

# -----------------------------------------------------------------------------
# Guest Checkout
# Single kill switch for password-less purchasing. When 'false', new guest
# checkouts and new magic links are blocked; existing orders stay retrievable.
# GUEST_LINK_TTL_HOURS defaults to 72 to match the download window.
# -----------------------------------------------------------------------------
GUEST_CHECKOUT_ENABLED=true
GUEST_LINK_TTL_HOURS=72

# -----------------------------------------------------------------------------
# WhatsApp (WAHA) — complementary to email, which stays the primary channel
# Self-hosted WAHA instance: https://waha.devlike.pro
# Nothing is sent until WAHA_API_KEY is filled in.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=true
WAHA_BASE_URL=https://waha.ngopicode.com
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
# Unpaid-order reminder: scan cadence and how long before expiry to remind.
WHATSAPP_REMINDER_INTERVAL_MINUTES=15
WHATSAPP_REMINDER_LEAD_MINUTES=60
# Set to false in extra processes if you ever run the worker separately,
# so the reminder scan runs in exactly one process.
WHATSAPP_REMINDER_ENABLED=true

# -----------------------------------------------------------------------------
# Search Index Maintenance
# Periodic full rebuild as a safety net against a stale index (deleted products
# lingering in search). Run scripts/reindex.js for an on-demand rebuild.
# -----------------------------------------------------------------------------
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# Requirements: 12.5, 13.5 (HTTPS enforcement)
# Create tunnel: cloudflared tunnel create ngopicode
# Get token from Cloudflare Zero Trust dashboard
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

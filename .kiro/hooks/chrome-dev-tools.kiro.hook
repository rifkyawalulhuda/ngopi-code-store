{
  "version": "1.0.0",
  "enabled": true,
  "name": "Chrome Dev Tools",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Jangan memakai Chrome Dev tools setiap task selesai, hanya memakai ketika kamu disuruh saja atau ada bug yang memang perlu lihat langsung lewat UI"
  }
}
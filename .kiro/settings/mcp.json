{
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "codegraph-ai@latest",
        "serve",
        "e:\\Github\\ngopi-code-store"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "codegraph_context",
        "codegraph_search",
        "codegraph_files",
        "codegraph_status",
        "search"
      ]
    },
    "nuxt": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://nuxt.com/mcp"
      ],
      "disabled": false,
      "autoApprove": [
        "list_documentation_pages",
        "get_documentation_page",
        "get_getting_started_guide",
        "list_blog_posts",
        "get_blog_post",
        "list_deploy_providers",
        "get_deploy_provider"
      ]
    }
  }
}
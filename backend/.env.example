# Server
PORT=3000
NODE_ENV=development
# ⚠️ PRODUCTION: Set NODE_ENV=production
# NODE_OPTIONS="--max-old-space-size=900"

# Database (PostgreSQL)
# Pool size is configured in vendure-config.ts (max: 10 connections)
# TypeORM uses parameterized queries by default to prevent SQL injection (Req 13.6)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ngopicode
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
# ⚠️ PRODUCTION: Gunakan password kuat dan unique, bukan 'postgres'

# Auth
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
COOKIE_SECRET=change-me-in-production
# ⚠️ PRODUCTION: WAJIB ganti superadmin credentials dan COOKIE_SECRET (gunakan random string 64 karakter)

# MinIO Object Storage
# Bucket is configured as PRIVATE - no public access (Req 13.1)
# Files are served exclusively via time-limited pre-signed URLs (5 min expiry)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=products
# Host used to SIGN download URLs. Must be reachable by the customer's browser
# AND be the same MinIO the backend uploads to, otherwise every download
# returns 404 NoSuchKey.
MINIO_PUBLIC_URL=http://localhost:9000
# ⚠️ PRODUCTION: Ganti MINIO_ACCESS_KEY dan MINIO_SECRET_KEY
# ⚠️ PRODUCTION: set MINIO_PUBLIC_URL ke host publik MinIO (mis. https://storage.ngopicode.com)

# Tripay Payment Gateway
TRIPAY_API_KEY=your-tripay-api-key
TRIPAY_PRIVATE_KEY=your-tripay-private-key
TRIPAY_MERCHANT_CODE=your-tripay-merchant-code
TRIPAY_SANDBOX=true
TRIPAY_CALLBACK_URL=http://localhost:3000/payments/tripay/webhook
TRIPAY_RETURN_URL=http://localhost:3001/order/confirmation
# ⚠️ PRODUCTION: WAJIB set TRIPAY_SANDBOX=false dan gunakan production API keys
# ⚠️ PRODUCTION: Ganti CALLBACK_URL dan RETURN_URL ke domain produksi (HTTPS)

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@localhost
EMAIL_FROM_NAME=NgopiCode Store

# Frontend URL (for email links)
STOREFRONT_URL=http://localhost:3001

# Guest Checkout
# Single kill switch for the guest purchase flow. When 'false':
#  - new guest checkouts are rejected,
#  - new magic order-access links are NOT issued.
# Already-issued links keep working so paid customers are never cut off.
GUEST_CHECKOUT_ENABLED=true
# Lifetime (hours) of a magic order-access link. Defaults to 72 to match the
# digital download window (DigitalProduct.downloadExpiryHours).
GUEST_LINK_TTL_HOURS=72

# WhatsApp (WAHA) — complementary to email, which stays the primary channel.
# Talks to a self-hosted WAHA instance (https://waha.devlike.pro).
# Nothing is sent until WAHA_API_KEY is filled in.
WHATSAPP_ENABLED=true
WAHA_BASE_URL=https://waha.ngopicode.com
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
# Unpaid-order reminder: scan cadence and how long before expiry to remind.
WHATSAPP_REMINDER_INTERVAL_MINUTES=15
WHATSAPP_REMINDER_LEAD_MINUTES=60
# Set to false in extra processes if you ever run the worker separately,
# so the reminder scan runs in exactly one process.
WHATSAPP_REMINDER_ENABLED=true

# Search index maintenance
# Periodic full rebuild as a safety net against a stale index (deleted products
# lingering in search). Run scripts/reindex.js for an on-demand rebuild.
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_INTERVAL_HOURS=24

# HTTPS Enforcement via Cloudflare Tunnel (Req 13.5)
# Required in production. Obtain token from Cloudflare Zero Trust dashboard.
# In development, HTTP is acceptable (tunnel not required).
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Memory limits (set via Node.js flags in production)
# Use: node --max-old-space-size=900 dist/index.js

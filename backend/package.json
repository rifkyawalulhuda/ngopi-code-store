{
  "name": "ngopicode-digital-store-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NgopiCode Digital Store - Vendure Backend",
  "scripts": {
    "dev": "ts-node --project tsconfig.json src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:pbt": "jest --testPathPattern=\\.pbt\\.spec\\.ts$"
  },
  "dependencies": {
    "@vendure/admin-ui-plugin": "^3.6.3",
    "@vendure/asset-server-plugin": "^3.6.3",
    "@vendure/core": "^3.6.3",
    "@vendure/dashboard": "^3.6.3",
    "@vendure/email-plugin": "^3.6.3",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
